---
interface Props {
  label: string;
  title: string;
  lede?: string;
}

const { label, title, lede } = Astro.props;
---

<header class="page-header">
  <div class="wrap">
    <p class="label">{label}</p>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(2rem, 6vw, 4.5rem) var(--space-l);
  }

  .label {
    margin-bottom: var(--space-s);
  }

  h1 {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .lede {
    margin-top: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.42;
    color: var(--ink-soft);
    max-width: 56ch;
  }
</style>
