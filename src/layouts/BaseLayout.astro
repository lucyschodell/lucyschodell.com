---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../lib/site";
import { getImage } from "astro:assets";
import { photos, type PhotoKey } from "../lib/photos";
import { personSchema, webSiteSchema, breadcrumbSchema, type Crumb } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Appended with the site name unless this is the homepage. */
  bareTitle?: boolean;
  /** Any JSON-LD objects to embed. */
  schema?: Record<string, unknown>[];
  /** Social preview image for this page. Falls back to the Atacama hero. */
  ogPhoto?: PhotoKey;
  /** Breadcrumb trail, excluding Home. */
  crumbs?: Crumb[];
}

const {
  title,
  description,
  bareTitle = false,
  schema = [],
  ogPhoto = "hero-atacama-highway",
  crumbs = [],
} = Astro.props;

// The domain lives in two places: `site` in astro.config.mjs (which drives the
// sitemap and robots.txt) and `origin` here (which drives canonical and OG
// URLs). If they ever drift, canonical tags point at a host the sitemap never
// lists, which quietly breaks indexing. Fail the build instead.
if (import.meta.env.PROD && Astro.site && Astro.site.origin !== new URL(site.origin).origin) {
  throw new Error(
    `Domain mismatch: astro.config.mjs has "${Astro.site.origin}" but src/lib/site.ts has "${site.origin}". Make them match.`,
  );
}

const canonical = new URL(Astro.url.pathname, site.origin).href;
const fullTitle = bareTitle ? title : `${title} | ${site.name}`;

// Each page gets its own social card, cropped to the 1.91:1 that Open Graph
// and X both expect.
const ogSource = photos[ogPhoto] ?? photos["hero-atacama-highway"];
const ogImage = await getImage({
  src: ogSource.src,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const ogImageUrl = new URL(ogImage.src, site.origin).href;

const allSchema = [
  personSchema(),
  webSiteSchema(),
  ...(crumbs.length ? [breadcrumbSchema(crumbs)] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name}: writing, films and appearances`}
      href="/rss.xml"
    />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogSource.alt} />

    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogSource.alt} />

    <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />


    {
      allSchema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />
      ))
    }
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

  </body>
</html>
