---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props {
  races: CollectionEntry<"races">[];
}

const { races } = Astro.props;
---

<ol class="races">
  {
    races.map((race) => (
      <li class="race">
        <div class="year numeric">{race.data.year}</div>

        <div class="detail">
          <h3 class="name">
            {race.data.reportUrl ? (
              <a href={race.data.reportUrl} rel="noopener">
                {race.data.name}
              </a>
            ) : (
              race.data.name
            )}
          </h3>
          <p class="place">{race.data.location}</p>
          <p class="blurb">{race.data.blurb}</p>
          {race.data.reportUrl && (
            <p class="action" aria-hidden="true">
              <span>Race report</span>
              <Icon name="arrow" size={14} />
            </p>
          )}
        </div>

        <dl class="stats numeric">
          <div>
            <dt>Distance</dt>
            <dd>{race.data.distance}</dd>
          </div>
          {race.data.time && (
            <div>
              <dt>Time</dt>
              <dd>{race.data.time}</dd>
            </div>
          )}
          {race.data.result && (
            <div>
              <dt>Result</dt>
              <dd class="result">{race.data.result}</dd>
            </div>
          )}
          {race.data.elevation && (
            <div>
              <dt>Climbing</dt>
              <dd>{race.data.elevation}</dd>
            </div>
          )}
        </dl>
      </li>
    ))
  }
</ol>

<style>
  .races {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .race {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 14rem;
    gap: var(--space-m);
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }

  .race:first-child {
    border-top: 1px solid var(--rule);
  }

  .year {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink-faint);
    padding-top: 0.1em;
  }

  .name {
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .name a {
    text-decoration: none;
    background-image: linear-gradient(var(--clay), var(--clay));
    background-size: 0% 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--transition);
  }

  .name a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .race:hover .name a {
    background-size: 100% 1.5px;
  }

  .place {
    margin-top: var(--space-3xs);
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .blurb {
    margin-top: var(--space-xs);
    color: var(--ink-soft);
    max-width: 54ch;
    line-height: 1.55;
  }

  .action {
    margin-top: var(--space-xs);
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--clay);
  }

  .action :global(svg) {
    transition: transform var(--transition);
  }

  .race:hover .action :global(svg) {
    transform: translateX(4px);
  }

  .stats {
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .stats div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .stats dt {
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .stats dd {
    margin: 0;
    font-size: var(--step-0);
  }

  .result {
    color: var(--clay);
    font-weight: 600;
  }

  @media (max-width: 60rem) {
    .race {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }

    .stats {
      grid-column: 2;
      margin-top: var(--space-xs);
      padding-top: var(--space-xs);
      border-top: 1px dotted var(--rule);
    }
  }

  @media (max-width: 34rem) {
    .stats div {
      grid-template-columns: 5rem 1fr;
    }
  }
</style>
