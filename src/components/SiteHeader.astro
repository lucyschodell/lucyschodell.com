---
import { nav, site } from "../lib/site";
import { getVideos } from "../lib/content";

const videos = await getVideos();
const items = nav.filter((item) =>
  item.requiresContent === "videos" ? videos.length > 0 : true,
);

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="wordmark" aria-label={`${site.name}, home`}>
      <span class="wordmark-name">{site.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-xs);
    min-height: 3.25rem;
  }

  .wordmark {
    text-decoration: none;
    flex-shrink: 0;
  }

  .wordmark-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variation-settings: "SOFT" 0, "WONK" 1;
  }

  .nav-list {
    display: flex;
    align-items: baseline;
    gap: clamp(0.75rem, 2.5vw, 1.9rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-list a {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    padding-block: var(--space-3xs);
    border-bottom: 1.5px solid transparent;
    transition: color var(--transition), border-color var(--transition);
    white-space: nowrap;
  }

  .nav-list a:hover {
    color: var(--ink);
    border-bottom-color: var(--clay);
  }

  .nav-list a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* On narrow screens the bar stacks and the nav scrolls horizontally rather
     than hiding behind a menu button — five items fit comfortably. */
  @media (max-width: 40rem) {
    .bar {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2xs);
      padding-block: var(--space-2xs) 0;
    }

    .wordmark-name {
      font-size: var(--step-0);
    }

    /* Wraps onto a second line rather than scrolling, so no item is ever
       hidden off the edge. */
    .nav-list {
      flex-wrap: wrap;
      gap: 0.35rem 1.05rem;
      padding-bottom: var(--space-2xs);
    }
  }
</style>
