---
import Figure from "./Figure.astro";
import Icon from "./Icon.astro";
import { formatDate, type MediaItem } from "../lib/content";

interface Props {
  item: MediaItem;
  /** "feature" gets a larger image and lead-in type. */
  variant?: "default" | "feature" | "compact";
  loading?: "lazy" | "eager";
}

const { item, variant = "default", loading = "lazy" } = Astro.props;

const kindLabel: Record<MediaItem["kind"], string> = {
  writing: "Essay",
  press: "Press",
  podcast: "Podcast",
  video: "Video",
};
---

<article class:list={["card", variant]}>
  {
    item.photo && variant !== "compact" && (
      <a href={item.url} class="media" tabindex="-1" aria-hidden="true">
        <Figure
          photo={item.photo}
          ratio={variant === "feature" ? "16/10" : "3/2"}
          sizes={
            variant === "feature"
              ? "(max-width: 48rem) 100vw, 60vw"
              : "(max-width: 48rem) 100vw, 33vw"
          }
          loading={loading}
          bare
        />
      </a>
    )
  }

  <div class="body">
    <p class="meta">
      <span class="kind">{kindLabel[item.kind]}</span>
      <span class="dot">·</span>
      <span>{item.source}</span>
      <span class="dot">·</span>
      <time datetime={item.date}>{formatDate(item.date)}</time>
    </p>

    <h3 class="title">
      <a href={item.url} rel="noopener">{item.title}</a>
    </h3>

    <p class="excerpt">{item.excerpt}</p>

    <p class="action" aria-hidden="true">
      <span>{item.action}</span>
      <Icon name="arrow" size={15} />
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    position: relative;
    height: 100%;
  }

  .body {
    flex: 1;
  }

  /* Keeps the call to action on a common baseline across a row of cards. */
  .action {
    margin-top: auto;
    padding-top: var(--space-2xs);
  }

  .media {
    display: block;
  }

  .card :global(.frame img) {
    transition: transform 900ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .card:hover :global(.frame img) {
    transform: scale(1.035);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .meta {
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    align-items: baseline;
  }

  .kind {
    color: var(--clay);
    font-weight: 600;
  }

  .dot {
    opacity: 0.5;
  }

  .title {
    font-size: var(--step-1);
    line-height: 1.15;
  }

  .feature .title {
    font-size: var(--step-3);
  }

  .title a {
    text-decoration: none;
    background-image: linear-gradient(var(--clay), var(--clay));
    background-size: 0% 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--transition);
  }

  /* The whole card is clickable, but only the title is a real link, so the
     accessible name and tab order stay clean. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card:hover .title a {
    background-size: 100% 1.5px;
  }

  .excerpt {
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.55;
    max-width: 58ch;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feature .excerpt {
    -webkit-line-clamp: 4;
    line-clamp: 4;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .compact .excerpt {
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .action {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--clay);
  }

  .action :global(svg) {
    transition: transform var(--transition);
  }

  .card:hover .action :global(svg) {
    transform: translateX(4px);
  }
</style>
