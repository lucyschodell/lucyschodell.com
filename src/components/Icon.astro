---
/** Inline monoline icons. Decorative by default — labels come from the link text. */
interface Props {
  name: "instagram" | "substack" | "linkedin" | "x" | "youtube" | "globe" | "mail" | "arrow";
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "instagram" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "substack" && (
      <>
        <path d="M4 4h16v2.5H4z" fill="currentColor" stroke="none" />
        <path d="M4 9.2h16v2.5H4z" fill="currentColor" stroke="none" />
        <path d="M4 14.4 12 19l8-4.6V21l-8-4.6L4 21z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "linkedin" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M7.5 10.5V17" />
        <circle cx="7.5" cy="7.2" r="0.9" fill="currentColor" stroke="none" />
        <path d="M11.5 17v-3.6a2.4 2.4 0 0 1 4.8 0V17" />
        <path d="M11.5 10.5V17" />
      </>
    )
  }
  {
    name === "x" && (
      <>
        <path d="M4 4l7.6 9.6L4.6 20" />
        <path d="M20 20l-7.6-9.6L19.4 4" />
      </>
    )
  }
  {
    name === "youtube" && (
      <>
        <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
        <path d="M10.2 9.6l5 2.4-5 2.4z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "globe" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="M3.5 7l8.5 6 8.5-6" />
      </>
    )
  }
  {
    name === "arrow" && (
      <>
        <path d="M5 12h14" />
        <path d="M13 6l6 6-6 6" />
      </>
    )
  }
</svg>
